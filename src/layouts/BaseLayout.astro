---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Notes on code, knitting, and learning about money — a notebook kept going.' } = Astro.props;

// 소셜 링크 — 본인 걸로 바꿔줘. 비워두면(빈 문자열) 자동으로 안 보임.
const social = {
  github: 'https://github.com/valiantotter',
  email: '', // 예: 'mailto:you@example.com'
  rss: '', // RSS는 나중에 필요하면 추가 가능
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="zfIBlEQ_wJ2oy_oZ95XpS7__zrKfB8kiBMM9YD49bfQ" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">F</span>
          <span class="brand-name">Filling the Back Pages</span>
        </a>
        <nav>
          <a href="/">Home</a>
          <a href="/blog/">Posts</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>

    <div class="wrap">
      <main>
        <slot />
      </main>

      <footer>
        <div class="footer-links">
          {social.github && (
            <a href={social.github} target="_blank" rel="noopener" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.1 3.29 9.4 7.86 10.94.57.1.78-.25.78-.55v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.26 5.69.42.36.78 1.07.78 2.17v3.22c0 .3.21.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/>
              </svg>
            </a>
          )}
          {social.email && (
            <a href={social.email} aria-label="Email">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/>
                <path d="m3 6 9 7 9-7"/>
              </svg>
            </a>
          )}
        </div>
        <p>&copy; {new Date().getFullYear()} · Built with Astro, hosted on GitHub Pages.</p>
      </footer>
    </div>

    <style>
      :root {
        --bg: #fbfbfd;
        --surface: #ffffff;
        --fg: #16181d;
        --muted: #686f7a;
        --accent: #3056d3;
        --accent-soft: #eef1fd;
        --border: #e7e8ec;
        --shadow: 0 1px 2px rgba(20, 20, 30, 0.04), 0 8px 24px rgba(20, 20, 30, 0.05);
        --radius: 14px;
        --font-head: 'Sora', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica,
          Arial, sans-serif;

        /* 카테고리별 색상 — src/lib/categories.ts 에서 참조함 */
        --cat-code: #3056d3;
        --cat-code-soft: #eef1fd;
        --cat-knitting: #c2255c;
        --cat-knitting-soft: #fbe4ee;
        --cat-money: #2f9e44;
        --cat-money-soft: #e8f7ea;
        --cat-diary: #e8890c;
        --cat-diary-soft: #fff3e0;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0d12;
          --surface: #12151c;
          --fg: #eef0f3;
          --muted: #9aa3b2;
          --accent: #8ca6ff;
          --accent-soft: rgba(140, 166, 255, 0.12);
          --border: #232733;
          --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 24px rgba(0, 0, 0, 0.35);

          --cat-code: #8ca6ff;
          --cat-code-soft: rgba(140, 166, 255, 0.14);
          --cat-knitting: #ff8fb3;
          --cat-knitting-soft: rgba(255, 143, 179, 0.14);
          --cat-money: #69db7c;
          --cat-money-soft: rgba(105, 219, 124, 0.14);
          --cat-diary: #ffb454;
          --cat-diary-soft: rgba(255,180,84,0.14);
        }
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      .wrap {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
      }

      .header-inner {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 1rem;
        color: var(--fg);
        text-decoration: none;
      }

      .brand-mark {
        display: inline-grid;
        place-items: center;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 8px;
        background: linear-gradient(135deg, var(--accent), #8ca6ff);
        color: white;
        font-family: var(--font-head);
        font-size: 0.9rem;
      }

      nav a {
        color: var(--muted);
        text-decoration: none;
        margin-left: 1.4rem;
        font-size: 0.92rem;
        font-weight: 500;
      }

      nav a:hover {
        color: var(--accent);
      }

      main {
        padding: 2.5rem 0 1rem;
      }

      a {
        color: var(--accent);
      }

      footer {
        margin-top: 3rem;
        padding: 1.75rem 0 3rem;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.85rem;
      }

      .footer-links {
        display: flex;
        gap: 0.9rem;
        margin-bottom: 0.75rem;
      }

      .footer-links a {
        color: var(--muted);
        display: inline-flex;
      }

      .footer-links a:hover {
        color: var(--accent);
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-head);
        line-height: 1.3;
        letter-spacing: -0.01em;
      }

      pre {
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 1rem;
        border-radius: var(--radius);
        overflow-x: auto;
      }

      code {
        font-size: 0.92em;
      }
    </style>
  </body>
</html>