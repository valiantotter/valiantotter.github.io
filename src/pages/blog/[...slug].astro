---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getCategory } from '../../lib/categories';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const cat = getCategory(post.data.category);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title={`${post.data.title} · My Startup & Dev Diary`} description={post.data.description}>
  <article class="post">
    <p class="back-row">
      <a class="back-link" href="/blog/">← All posts</a>
    </p>

    <header class="post-head">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <span class="cat-badge" style={`color:${cat.color}; background:${cat.soft}`}>{cat.label}</span>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.tags && post.data.tags.length > 0 && (
          <span class="tags">
            {post.data.tags.map((t) => <span class="tag">{t}</span>)}
          </span>
        )}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <style>
    .back-row {
      margin: 0 0 1.5rem;
    }
    .back-link {
      font-size: 0.88rem;
      font-weight: 600;
      text-decoration: none;
      color: var(--muted);
    }
    .back-link:hover {
      color: var(--accent);
    }

    .post-head {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    .post-head h1 {
      font-size: clamp(1.9rem, 4.5vw, 2.4rem);
      margin: 0 0 0.75rem;
    }
    .meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .meta time {
      color: var(--muted);
      font-size: 0.88rem;
    }
    .cat-badge {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
    }
    .tags {
      display: flex;
      gap: 0.4rem;
    }
    .tag {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--accent);
      background: var(--accent-soft);
      padding: 0.15rem 0.55rem;
      border-radius: 999px;
    }

    .prose {
      font-size: 1.03rem;
    }
    .prose :global(p) {
      margin: 0 0 1.2rem;
    }
    .prose :global(h2) {
      margin: 2rem 0 0.9rem;
      font-size: 1.4rem;
    }
    .prose :global(h3) {
      margin: 1.6rem 0 0.7rem;
      font-size: 1.15rem;
    }
    .prose :global(blockquote) {
      margin: 1.2rem 0;
      padding: 0.2rem 1.1rem;
      border-left: 3px solid var(--accent);
      color: var(--muted);
    }
    .prose :global(ul),
    .prose :global(ol) {
      margin: 0 0 1.2rem;
      padding-left: 1.3rem;
    }
    .prose :global(li) {
      margin-bottom: 0.4rem;
    }
    .prose :global(img) {
      max-width: 100%;
      border-radius: var(--radius);
    }
    .prose :global(a) {
      text-decoration: underline;
      text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    }
    .prose :global(code:not(pre code)) {
      background: var(--accent-soft);
      color: var(--accent);
      padding: 0.15rem 0.4rem;
      border-radius: 6px;
    }
  </style>
</BaseLayout>
