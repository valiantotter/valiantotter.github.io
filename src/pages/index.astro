---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, getCategory } from '../lib/categories';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<BaseLayout title="Filling the Back Pages">
  <section class="hero">
    <span class="eyebrow">📓 A notebook, kept going</span>
    <h1>Filling the back pages</h1>
    <p class="lede">
      I always fill only the front of a notebook. This is my attempt to keep
      going: notes on code, knitting, and learning about money, written in
      the one hour a day I can spare.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/blog/">Read the posts →</a>
      <a class="btn btn-ghost" href="/about/">About</a>
    </div>

    <div class="cat-row">
      {
        Object.entries(CATEGORIES).map(([key, cat]) => (
          <a class="cat-pill" href={`/blog/category/${key}/`} style={`--c:${cat.color}; --c-soft:${cat.soft}`}>
            {cat.label}
          </a>
        ))
      }
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>Latest posts</h2>
      {posts.length > 0 && <a class="see-all" href="/blog/">See all →</a>}
    </div>

    {posts.length === 0 && (
      <p class="empty">No posts yet — add one in <code>src/content/blog/</code>.</p>
    )}

    <ul class="post-list">
      {
        posts.map((post) => {
          const cat = getCategory(post.data.category);
          return (
            <li>
              <a class="post-card" href={`/blog/${post.id}/`}>
                <div class="post-card-top">
                  <span class="cat-badge" style={`color:${cat.color}; background:${cat.soft}`}>
                    {cat.label}
                  </span>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="read-more">Read →</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <style>
    .hero {
      padding: 1.5rem 0 3rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 2.5rem;
    }

    .eyebrow {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--accent);
      background: var(--accent-soft);
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      margin-bottom: 1rem;
    }

    h1 {
      font-size: clamp(2.1rem, 5vw, 2.75rem);
      margin: 0 0 0.9rem;
      background: linear-gradient(135deg, var(--fg), var(--accent) 120%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .lede {
      font-size: 1.05rem;
      color: var(--muted);
      max-width: 42rem;
      margin: 0 0 1.75rem;
    }

    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    .cat-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .cat-pill {
      display: inline-block;
      font-size: 0.82rem;
      font-weight: 600;
      text-decoration: none;
      color: var(--c, var(--muted));
      background: var(--c-soft, var(--surface));
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      transition: transform 0.15s ease;
    }

    .cat-pill:hover {
      transform: translateY(-1px);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      font-weight: 600;
      font-size: 0.92rem;
      padding: 0.6rem 1.1rem;
      border-radius: 10px;
      text-decoration: none;
      border: 1px solid transparent;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .btn-primary {
      background: var(--accent);
      color: white;
    }

    .btn-ghost {
      border-color: var(--border);
      color: var(--fg);
    }

    .btn:hover {
      transform: translateY(-1px);
      box-shadow: var(--shadow);
    }

    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 1.1rem;
    }

    .see-all {
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
    }

    .empty {
      color: var(--muted);
    }

    .post-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.9rem;
    }

    .post-card {
      display: block;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem 1.4rem;
      text-decoration: none;
      color: var(--fg);
      transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    }

    .post-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow);
      border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    }

    .post-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }

    .post-card time {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .cat-badge {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
    }

    .post-card h3 {
      margin: 0 0 0.35rem;
      font-size: 1.15rem;
    }

    .post-card p {
      margin: 0;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .read-more {
      display: inline-block;
      margin-top: 0.6rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent);
    }
  </style>
</BaseLayout>